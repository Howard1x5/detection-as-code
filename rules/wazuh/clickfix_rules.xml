<!--
  ClickFix / Paste-to-Run Detection Rules for Wazuh
  Author: Clint Howard
  Date: 2026-08-20

  ClickFix is a social-engineering technique: a fake CAPTCHA or browser error
  page uses JavaScript to write an attacker command to the victim's clipboard,
  then instructs them to press Win+R, Ctrl+V, Enter. The victim runs the
  command themselves, which sidesteps download and macro controls entirely.
  Observed in 2026 delivering StealC, Lumma Stealer and Amatera.

  Detection strategy:
  - RunMRU registry writes are the strongest artifact. HKCU\...\Explorer\RunMRU
    records what was typed into the Run dialog and survives process exit.
  - mshta.exe and PowerShell spawned from explorer.exe (rather than from a
    shell or script host) is the paste-to-run parent relationship.
  - Outbound network connections from mshta.exe are rare in normal use.

  Prerequisites:
  - Sysmon installed on Windows endpoints
  - Wazuh agent forwarding the Sysmon eventchannel

  Parent Rule References:
  - 61603: Sysmon Event ID 1 (Process Creation)
  - 61605: Sysmon Event ID 3 (Network Connection)
  - 61615: Sysmon Event ID 13 (Registry SetValue)

  BACKSLASH CONVENTION (important):
  The windows_eventchannel decoder emits DOUBLED backslashes. Path patterns
  must use \\+ (one-or-more) rather than \\ (exactly one), or the rule will
  parse fine and silently never fire on real agent data. All 42 path patterns
  in this repo were corrected for this on 2026-08-20; new rules follow suit.

  Rule ID Range: 100700-100799 (Custom ClickFix rules)
-->

<group name="clickfix,social_engineering,malware,">

  <!-- ============================================ -->
  <!-- PASTE-TO-RUN ARTIFACT - RunMRU              -->
  <!-- MITRE: T1204.004                            -->
  <!-- ============================================ -->

  <!--
    RunMRU records Run-dialog input. A remote-execution verb appearing here
    means a human typed or pasted it, which is exactly the ClickFix pattern.
  -->
  <rule id="100700" level="13">
    <if_sid>61615</if_sid>
    <field name="win.eventdata.targetObject" type="pcre2">(?i)\\+Explorer\\+RunMRU\\+</field>
    <field name="win.eventdata.details" type="pcre2">(?i)(mshta|powershell|pwsh|curl\.exe|certutil|bitsadmin|rundll32)</field>
    <description>ClickFix: RunMRU entry contains remote-execution command (paste-to-run lure)</description>
    <mitre>
      <id>T1204.004</id>
    </mitre>
    <group>clickfix,execution,runmru,critical,</group>
  </rule>

  <!--
    Narrower and higher confidence: the in-memory download-and-execute idiom.
    ClickFix payloads commonly build irm/iwr at runtime and pipe into iex so
    nothing recognisable touches disk.
  -->
  <rule id="100701" level="14">
    <if_sid>61615</if_sid>
    <field name="win.eventdata.targetObject" type="pcre2">(?i)\\+Explorer\\+RunMRU\\+</field>
    <field name="win.eventdata.details" type="pcre2">(?i)(iex|invoke-expression|irm|invoke-restmethod|iwr|invoke-webrequest|downloadstring)</field>
    <description>ClickFix: RunMRU entry contains in-memory download-and-execute idiom</description>
    <mitre>
      <id>T1204.004</id>
      <id>T1059.001</id>
    </mitre>
    <group>clickfix,execution,runmru,critical,</group>
  </rule>

  <!-- ============================================ -->
  <!-- PROXY EXECUTION - mshta from explorer        -->
  <!-- MITRE: T1218.005                            -->
  <!-- ============================================ -->

  <!--
    mshta parented by explorer.exe means it was launched from the Run dialog,
    a shortcut or a double-click rather than by a script or installer. Combined
    with a remote URL argument this is the ClickFix delivery step.
  -->
  <rule id="100710" level="14">
    <if_sid>61603</if_sid>
    <field name="win.eventdata.image" type="pcre2">(?i)\\+mshta\.exe$</field>
    <field name="win.eventdata.parentImage" type="pcre2">(?i)\\+explorer\.exe$</field>
    <field name="win.eventdata.commandLine" type="pcre2">(?i)(https?://|\\\\\\\\)</field>
    <description>ClickFix: mshta launched from Explorer with a remote target</description>
    <mitre>
      <id>T1218.005</id>
      <id>T1204.004</id>
    </mitre>
    <group>clickfix,execution,proxy_execution,critical,</group>
  </rule>

  <!--
    PowerShell parented by explorer.exe with an encoded or hidden-window flag.
    Legitimate interactive PowerShell from Explorer is common; encoded or
    hidden PowerShell from Explorer is not.
  -->
  <rule id="100711" level="13">
    <if_sid>61603</if_sid>
    <field name="win.eventdata.image" type="pcre2">(?i)\\+(powershell|pwsh)\.exe$</field>
    <field name="win.eventdata.parentImage" type="pcre2">(?i)\\+explorer\.exe$</field>
    <field name="win.eventdata.commandLine" type="pcre2">(?i)(-enc|-e\s|-encodedcommand|-w\s+hidden|-windowstyle\s+hidden|-nop|-noprofile)</field>
    <description>ClickFix: PowerShell launched from Explorer with encoded or hidden-window flags</description>
    <mitre>
      <id>T1059.001</id>
      <id>T1204.004</id>
    </mitre>
    <group>clickfix,execution,powershell,critical,</group>
  </rule>

  <!-- ============================================ -->
  <!-- C2 / STAGING - outbound from mshta           -->
  <!-- MITRE: T1071.001                            -->
  <!-- ============================================ -->

  <!--
    mshta making outbound network connections is rare in a normal desktop
    baseline. Tune with an allowlist if a line-of-business app uses HTA.
  -->
  <rule id="100720" level="12">
    <if_sid>61605</if_sid>
    <field name="win.eventdata.image" type="pcre2">(?i)\\+mshta\.exe$</field>
    <description>ClickFix: mshta.exe established an outbound network connection</description>
    <mitre>
      <id>T1071.001</id>
      <id>T1218.005</id>
    </mitre>
    <group>clickfix,command_control,</group>
  </rule>

</group>
